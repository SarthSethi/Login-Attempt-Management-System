# Copy this file to ".env" and fill in your own values.
# .env is listed in .gitignore and must never be committed.

# ---------- Database ----------
# Local MySQL / Docker Compose (the database is created automatically if the user may create it)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=login_monitoring_system
# PREFERRED for local MySQL, REQUIRED for a cloud database (Aiven)
DB_SSL_MODE=PREFERRED
DB_USERNAME=lams_user
DB_PASSWORD=change-me-db-password
# Host port for the Docker Compose MySQL (use 3307 if a local MySQL already uses 3306)
MYSQL_HOST_PORT=3306
# Only used by docker-compose.yml to initialise the MySQL container
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---------- Administrator account (created/updated on startup) ----------
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
# At least 8 characters with a letter and a digit
ADMIN_PASSWORD=change-me-admin-password

# ---------- Login protection (defaults shown) ----------
# Rule 1: failures for one account from one IP before that pair is locked
MAX_FAILED_ATTEMPTS=5
MONITORING_WINDOW=10m
BLOCK_DURATION=15m
# Rule 2 (different accounts from one IP) and Rule 3 (failures from one IP) -> IP blocked
IP_MAX_ACCOUNTS=4
IP_MAX_FAILURES=10
# Rule 4: failures on one account from at least N IPs -> account locked for new IPs
ACCOUNT_MAX_FAILURES=8
ACCOUNT_MIN_IPS=3
# Rule 5: length of the 2nd, 3rd, ... block of the same IP within 24 hours
REPEAT_BLOCK_DURATIONS=1h,24h
# IPs/CIDRs of trusted reverse proxies. Leave EMPTY for local development.
# (On Render nothing is needed: Render sets RENDER=true and Cloudflare's header is used.)
TRUSTED_PROXIES=

# ---------- Free outside services (need internet, no account) ----------
IP_LOOKUP_ENABLED=true
BREACH_CHECK_ENABLED=true
# Login attempts older than this are deleted every night
ATTEMPT_RETENTION=180d

# ---------- Misc ----------
# HTTP port of the app (change if 8080 is already used on your computer)
PORT=8080
# Display time zone for the dashboards (storage is always UTC)
DISPLAY_TIMEZONE=Asia/Kolkata
# true when served over HTTPS (production)
SESSION_COOKIE_SECURE=false
