' Shared look for all LAMS diagrams
skinparam dpi 160
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam ArrowColor #34495e
skinparam ArrowFontSize 11
skinparam ArrowFontColor #333333
skinparam roundCorner 6
skinparam NoteBackgroundColor #fdf2e3
skinparam NoteBorderColor #e0a050
skinparam ActorBorderColor #22385a
skinparam ActorBackgroundColor #dfe6f0
skinparam UsecaseBackgroundColor #eef3fa
skinparam UsecaseBorderColor #22385a
skinparam RectangleBorderColor #22385a
skinparam ComponentBackgroundColor #eef3fa
skinparam ComponentBorderColor #22385a
skinparam DatabaseBackgroundColor #e8f1e8
skinparam DatabaseBorderColor #3d7a4f
skinparam ClassBackgroundColor #ffffff
skinparam ClassBorderColor #22385a
skinparam ClassHeaderBackgroundColor #dfe6f0
skinparam EntityBackgroundColor #ffffff
skinparam EntityBorderColor #22385a
skinparam ParticipantBackgroundColor #eef3fa
skinparam ParticipantBorderColor #22385a
skinparam SequenceLifeLineBorderColor #8a96a3
skinparam ActivityBackgroundColor #eef3fa
skinparam ActivityBorderColor #22385a
skinparam ActivityDiamondBackgroundColor #fdf2e3
skinparam ActivityDiamondBorderColor #c0661a
skinparam StateBackgroundColor #eef3fa
skinparam StateBorderColor #22385a
skinparam NodeBackgroundColor #f6f7f9
skinparam NodeBorderColor #22385a
